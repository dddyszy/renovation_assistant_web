{
  "name": "zhu-jia-web",
  "version": "0.9.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.server.json && vite build && node scripts/compress.mjs",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "demo": "tsx scripts/demo.ts",
    "migrate:storage": "tsx scripts/migrate-storage.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.8",
    "@lucide/vue": "^1.64.0",
    "@node-rs/argon2": "^2.0.2",
    "@tanstack/vue-query": "^5.90.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "nodemailer": "^10.3.1",
    "pg": "^8.16.3",
    "pinia": "^3.0.3",
    "tsx": "^4.20.6",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.9.1",
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.15.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vue-tsc": "^3.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
