# 复制为 .env.docker 后填写。逐项说明见 docs/docker-parameters.md。
# 【通用】内置存储通常只需修改 APP_ORIGIN；下面镜像和端口可保留默认。
APP_IMAGE_TAG=0.9.5
# 仅 compose.image.yaml 使用；镜像名不要带 :0.9.5，版本由 APP_IMAGE_TAG 单独指定。
APP_IMAGE=ghcr.io/dddyszy/renovation_assistant_web
# 【必填】浏览器真实 HTTPS 来源，不带路径和结尾 /；必须替换示例域名。
APP_ORIGIN=https://renovation.example.com
# 宿主机回环端口，已有代理可转发到 127.0.0.1:8080；不改变容器内 3001 端口。
APP_PORT=8080
# 【仅使用 compose.https.yaml 时必填】域名，不带 https:// 或路径；需与 APP_ORIGIN 对应。
DOMAIN=renovation.example.com
# 【仅使用 compose.bind.yaml 时必填】宿主机绝对路径，目录需允许 UID/GID 1000 写入。
DATA_DIR=/srv/zhu-jia/data
# 【数据库】内置模式忽略全部 POSTGRES_*，无需填数据库密码。
# 外部 PostgreSQL：填写已有数据库的真实连接信息，替换示例地址、库名和账号。
# Compose 自带 PostgreSQL 默认 18，兼容 17（compose.postgres17.yaml）。
# 自带模式只需设置密码，库名/账号可保留默认；HOST/PORT/SSLMODE 被忽略。
POSTGRES_HOST=db.example.internal
POSTGRES_PORT=5432
POSTGRES_DB=zhu_jia
POSTGRES_USER=zhu_jia
# 外部模式填已有密码，自带模式生成新随机密码；两种模式均不能为空。
# 含 $、# 等字符时用单引号包住完整值，避免 Compose 变量替换或注释解析。
POSTGRES_PASSWORD=
# 仅外部模式使用：可信 TLS 证书用 verify-full；明确无 TLS 的受控内网用 disable。
POSTGRES_SSLMODE=verify-full
# 【可选邮件】仅忘记密码时使用；普通注册登录不需要，未启用可保持以下空值。
SMTP_HOST=
# 通常 587 使用 STARTTLS，465 使用直接 TLS，按服务商要求填写。
SMTP_PORT=587
# 服务商要求认证时，填写 SMTP 账号与授权码/密码。
SMTP_USER=
SMTP_PASSWORD=
# 只要填写 SMTP_HOST 就必填，例如：'筑家手记 <noreply@example.com>'。
SMTP_FROM=
