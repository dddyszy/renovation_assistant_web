# Common settings: APP_ORIGIN must be an HTTPS origin, with no trailing slash.
APP_IMAGE_TAG=0.9.5
# Used with compose.image.yaml to pull prebuilt images.
APP_IMAGE=ghcr.io/dddyszy/renovation_assistant_web
APP_ORIGIN=https://renovation.example.com
APP_PORT=8080
# Used only when compose.https.yaml is enabled.
DOMAIN=renovation.example.com
# Optional host directory; used only with compose.bind.yaml.
DATA_DIR=/srv/zhu-jia/data
# PostgreSQL settings; not needed for the embedded mode.
POSTGRES_HOST=db.example.internal
POSTGRES_PORT=5432
POSTGRES_DB=zhu_jia
POSTGRES_USER=zhu_jia
POSTGRES_PASSWORD=
# verify-full is recommended when the external server supports a trusted TLS certificate.
POSTGRES_SSLMODE=verify-full
# Optional: only password-recovery email uses SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
