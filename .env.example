# 复制为 .env。Docker 默认只需修改 APP_ORIGIN；本机可保留此地址。
# 本地 npm run dev 时请改为 http://localhost:5173。
APP_ORIGIN=http://localhost:8080

# 可选：SMTP 密码找回。使用时叠加 -f compose.smtp.yaml。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 可选：Compose PostgreSQL 18 / 17。使用时填写密码并叠加对应 compose 文件。
POSTGRES_DB=zhu_jia
POSTGRES_USER=zhu_jia
POSTGRES_PASSWORD=

# 可选：已有外部 PostgreSQL，配合 compose.external.yaml。
# POSTGRES_HOST=db.example.internal
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=verify-full

# 可选：预构建镜像配合 compose.image.yaml；目录挂载配合 compose.bind.yaml。
# APP_IMAGE=ghcr.io/dddyszy/renovation_assistant_web
# APP_IMAGE_TAG=0.9.7
# DATA_DIR=/srv/zhu-jia/data
