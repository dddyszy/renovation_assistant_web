# 复制为 .env。默认只需修改 APP_ORIGIN；本机可保留此地址。
# 本地 npm run dev 时请改为 http://localhost:5173。
APP_ORIGIN=http://localhost:8080

# 可选：Compose 自带 PostgreSQL，只需设置一个密码。
# POSTGRES_PASSWORD=

# 可选：连接已有 PostgreSQL，填一条连接串；密码含特殊字符时先做 URL 编码。
# DATABASE_URL=postgresql://zhu_jia:password@db.example.internal:5432/zhu_jia?sslmode=verify-full

# 可选：预构建镜像；宿主机目录挂载。
# APP_IMAGE=ghcr.io/dddyszy/renovation_assistant_web
# APP_IMAGE_TAG=0.9.9
# DATA_DIR=/srv/zhu-jia/data
