# Leave empty for durable embedded PostgreSQL in .data/postgres.
DATABASE_URL=
# Alternatively leave DATABASE_URL empty and set PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD/PGSSLMODE.
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
# Production requires NODE_ENV=production and APP_ORIGIN set to the browser-facing origin.
# SMTP is optional; only password-recovery email needs SMTP_*.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
